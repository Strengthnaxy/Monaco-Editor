{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Qwen Editor",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "open": true },
      "dialog": { "all": true },
      "fs": { "all": true, "scope": ["$HOME/**", "$DESKTOP/**", "$DOCUMENT/**"] }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.qwen.editor",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Qwen Code Editor",
        "width": 1000,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400
      }
    ]
  }
}
